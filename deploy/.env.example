# ── TFT Copilot 环境变量 ─────────────────────────────────────────────────────
# 必填：LLM provider 三选一 deepseek / openai / ark
LLM_PROVIDER=deepseek

# deepseek / openai 通用（OPENAI_* 为兼容命名）
OPENAI_API_KEY=sk-在这里填入你的APIKey
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 火山引擎豆包·在线推理（LLM_PROVIDER=ark 时必填，按量计费）
# ARK_API_KEY=
# ARK_MODEL_ID=

# 火山方舟 Coding Plan（编程套餐）用户：走 OpenAI 兼容路径 + 专用 Base URL
# ⚠️ Base URL 必须是 api/coding/v3，不是 api/v3（后者是在线推理，会 404/额外计费）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ark-你的CodingPlanKey
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# OPENAI_MODEL=ark-code-latest

# ── 可选调优 ──────────────────────────────────────────────────────────────────
# 服务端口（默认 8080）
PORT=8080

# 日志环境：prod 时 gin 关闭 debug 输出
LOG_ENV=prod

# 限流：每 IP 每秒请求上限（0/未设置 = 不限流）+ 突发额度
# RATE_LIMIT_RPS=5
# RATE_LIMIT_BURST=10

# 关闭 legacy /v1/tft/analyze 链路以省启动开销（被禁用接口返回 410）
# DISABLE_LEGACY_GRAPH=true

# 链路追踪日志（排障时开启）
# TRACE=true

# ── LLM 推理调优（均有默认值，一般无需修改） ───────────────────────────────────
# LLM_TIMEOUT_SEC=60        # 单次推理超时（秒），默认 60
# LLM_MAX_TOKENS=200        # 输出长度上限，默认 200（越小首 token 越快）
# LLM_TEMPERATURE=0.7       # 默认 0.7
# ARK_TIMEOUT_SEC=60        # 仅 ark provider 生效

# ── 日志级别（默认 info） ──────────────────────────────────────────────────────
# LOG_LEVEL=info            # debug | info | warn | error

# ── 数据目录覆盖（标准部署无需设置，install.sh 已按默认布局安装） ──────────────
# TFT_DATA_DIR=/opt/tft-copilot/metadata/tft-meta/data
# TFT_KNOWLEDGE_DIR=/opt/tft-copilot/tft/knowledge/data
# TFT_ALIASES_FILE=/opt/tft-copilot/tft/knowledge/data/aliases.json
