{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tft/release/contracts/evidence_envelope.schema.json",
  "title": "EvidenceEnvelope",
  "description": "TFT 数据发布契约 v1：证据信封。回答/日志/反馈/评测共享版本身份；样本按事实记录，不把不同阵容 Count 相加当去重对局数；LLM 不补缺失事实（用 warnings 表达）。",
  "type": "object",
  "required": ["trace_id", "release_id", "scope", "source_ids", "freshness", "sample_policy", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "data_scope.schema.json" },
    "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "freshness": {
      "type": "object",
      "required": ["fetched_at", "stats_window_end", "effective_at", "built_at"],
      "additionalProperties": false,
      "properties": {
        "fetched_at": { "type": "string", "format": "date-time" },
        "stats_window_end": { "type": "string", "format": "date-time" },
        "effective_at": { "type": "string", "format": "date-time" },
        "built_at": { "type": "string", "format": "date-time" }
      }
    },
    "sample_policy": {
      "type": "object",
      "required": ["min_sample_floor", "below_floor_action"],
      "additionalProperties": false,
      "properties": {
        "min_sample_floor": { "type": "integer", "minimum": 0 },
        "below_floor_action": { "enum": ["degrade_basic", "reject"] },
        "note": { "type": "string" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["base_facts", "meta_stats", "patch_notes", "champion_profiles", "items_priority", "slang_nlu", "knowledge"] }
    }
  }
}
