{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tft/release/contracts/deployment_manifest.schema.json",
  "title": "DeploymentManifest",
  "description": "TFT 数据发布契约 v1：部署组合身份。应用镜像/数据 release/prompt/策略/模型配置一起构成 deployment；禁止写模型密钥。",
  "type": "object",
  "required": ["deployment_id", "image_digest", "app_commit", "data_release_id", "prompt_version", "policy_version", "model_config_version", "created_at"],
  "additionalProperties": false,
  "properties": {
    "deployment_id": { "type": "string", "minLength": 1 },
    "image_digest": { "type": "string", "minLength": 1 },
    "app_commit": { "type": "string", "minLength": 1 },
    "data_release_id": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "model_config_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
